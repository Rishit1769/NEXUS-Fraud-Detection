DATABASE_URL="mysql://nexus:nexus_password@localhost:3306/nexus_fraud"
MYSQL_DATABASE="nexus_fraud"
MYSQL_USER="nexus"
MYSQL_PASSWORD="nexus_password"
MYSQL_ROOT_PASSWORD="root_password"
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_NAME="NEXUS Fraud Detection"
# AI explanation provider (OpenAI-compatible chat/completions).
# Defaults to OpenCode's Go gateway; admin can override at runtime via SystemSetting.
# AI_PROVIDER="opencode"
# AI_API_KEY="oc_sk_..."
# AI_BASE_URL="https://opencode.ai/zen/go/v1"
# AI_MODEL="deepseek-v4.1-flash"
# Optional: Redis for distributed rate limits / job locks.
# REDIS_URL="redis://localhost:6379"
# Optional internal XGBoost model API. When unset, deterministic analysis remains
# fully functional and the website records the model as unavailable.
# MODEL_API_URL="http://localhost:8001"
# MODEL_API_SECRET="replace-with-a-long-random-model-service-secret"
# MODEL_API_TIMEOUT_MS="1500"
# Set true in production to prevent deployment with old artifacts that ignore
# the LLM-derived model features.
# REQUIRE_LLM_FEATURES="true"
